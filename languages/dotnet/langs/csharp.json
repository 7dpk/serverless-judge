{
  "name": "csharp",
  "title": "C# (.NET 10)",
  "ids": [51],
  "source_file": "main.cs",
  "env": {
    "DOTNET_EnableWriteXorExecute": "0",
    "DOTNET_TieredPGO": "0"
  },
  "warmup": {
    "cmd": [
      "sh",
      "-c",
      "echo 'class P { static void Main() { System.Console.WriteLine(1); } }' > main.cs && /opt/lang/compile.sh && dotnet main.dll"
    ]
  },
  "compile": {
    "cmd": [
      "/opt/lang/compile.sh",
      "{options}"
    ]
  },
  "run": {
    "cmd": [
      "dotnet",
      "main.dll",
      "{args}"
    ]
  }
}
