# Copy to terraform.tfvars and edit. Only project is required.
project = "my-project-id"

# region = "us-central1"

# Deploy only some languages (folders under languages/):
# families = ["python", "gcc", "node"]

# Raise a family's instance cap without editing its service.json:
# max_instances = { gcc = 40 }
# cpu_quota     = 400        # after Google has raised the regional CPU quota

# Run a second copy in the same project:
# name_prefix = "staging-"

# Let submissions ask for network access with enable_network. Off by
# default. Read docs/architecture.md#network-access before turning it on.
# allow_network          = true
# network_time_limit     = 30    # seconds, added to the wall time limit
# max_network_time_limit = 60
# max_download_mb        = 125
